{
	"manifest_version": 3,

	"name": "World Clocks New Tab",
	"description": "Replace default new tab page in Chrome with world clocks.",
	"version": "1.0",

	"chrome_url_overrides": {
		"newtab": "tab.html"
	},
	"permissions": [
		"bookmarks",
		"storage"
	],
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	}
}
